# AI layer: Amazon Bedrock is used first when AWS is configured, then Groq, then an offline template.
LLM_PROVIDER=auto
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Option A: AWS keys (or run `aws configure` and set BEDROCK_ENABLED=1)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Option B: Groq fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Set to 1 to blend real Open-Meteo weather into temperature and rainfall inputs
USE_LIVE_DATA=0
# Optional: store raw + processed environmental snapshots in Amazon S3 (otherwise saved to ./data in the same layout)
S3_BUCKET=
# Optional: Amazon SageMaker real-time endpoint for the Nexus model (see aws/deploy.py). Empty = local model.
SAGEMAKER_ENDPOINT=
# Optional: agent hosted on Amazon Bedrock AgentCore Runtime (see agentcore/agent.py). Used before plain Bedrock when set.
AGENTCORE_RUNTIME_ARN=
AGENT_MODEL_ID=
